{
  "name": "desktop-pet-translator",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop pet translator",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "lint": "eslint .",
    "prebuild": "node scripts/provision-live2d-assets.mjs",
    "predev": "node scripts/provision-live2d-assets.mjs",
    "start": "electron-vite preview",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^5.3.12",
    "pixi-live2d-display": "0.3.1",
    "pixi.js": "5.3.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
